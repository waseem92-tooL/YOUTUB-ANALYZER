# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Google Cloud OAuth 2.0 Credentials (for allowing users to connect their YouTube Channels)
# Create in Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID -> Web Application
# Authorized redirect URI: <APP_URL>/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional YouTube Data API v3 Key (for high-volume public channel lookup)
YOUTUBE_API_KEY=""

# Session encryption secret (fallback is randomly generated in memory on boot)
SESSION_SECRET="youtube-analyzer-ai-wasim-akram-secure-session"
